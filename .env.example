# --- Base de datos -----------------------------------------------------------
# La contraseña debe coincidir con POSTGRES_PASSWORD (docker-compose la lee de este mismo archivo).
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL="postgresql://soldeer_user:cambia-esta-clave@localhost:8090/soldeer_db"

# --- Panel de administración (OBLIGATORIO en producción) ---------------------
# Sin estas dos variables, /admin queda bloqueado cuando NODE_ENV=production.
ADMIN_USER=admin
ADMIN_PASSWORD=usa-una-clave-larga-y-unica

# --- Imágenes subidas ---------------------------------------------------------
# Carpeta persistente (en servidor/Docker móntala como volumen). Por defecto: ./storage/uploads
# UPLOAD_DIR=/var/data/soldeer/uploads
# Peso máximo por imagen en MB (por defecto 10)
# MAX_UPLOAD_MB=10

# --- Sitio público ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp en formato internacional sin "+" (por defecto 591 + teléfono de la sucursal central)
# NEXT_PUBLIC_WHATSAPP_NUMBER=59175353583
