generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive, order])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  offerPrice  Decimal? @db.Decimal(12, 2)
  sku         String?
  stock       Int      @default(10)
  images      String[]
  isPublished Boolean  @default(true)
  // Si ningún producto está marcado como destacado, el home muestra los más recientes.
  isFeatured  Boolean  @default(false)

  // Campos técnicos de ingeniería para soldadura (todos opcionales)
  maxAmperage    String?
  workCycle      String?
  powerSupply    String?
  weldingProcess String?
  presentation   String?
  dimensions     String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isPublished, isFeatured, createdAt])
}

// Reservado para el flujo de cotizaciones guardadas en base de datos (fase siguiente).
model OrderItem {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  price     Decimal
}
